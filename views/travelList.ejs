<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мои путешествия</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding: 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        h1 {
            color: #333;
            font-size: 32px;
            font-weight: 600;
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #333;
            font-weight: 500;
        }

        .avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }

        /* Сообщения */
        .alert {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        /* Сетка путешествий */
        .travels-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }

        .travel-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: all 0.3s;
            position: relative;
        }

        .travel-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.15);
        }

        .travel-card-header {
            padding: 20px;
            border-bottom: 2px solid #f0f0f0;
            position: relative;
        }

        .travel-card-title {
            font-size: 20px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .travel-dates {
            color: #666;
            font-size: 14px;
            background: #f8f9fa;
            padding: 4px 8px;
            border-radius: 6px;
            display: inline-block;
        }

        .travel-card-body {
            padding: 20px;
        }

        .travel-location {
            color: #2196F3;
            font-weight: 500;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .travel-description {
            color: #666;
            line-height: 1.6;
            font-size: 15px;
            margin-bottom: 15px;
            max-height: 60px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .travel-card-footer {
            padding: 15px 20px;
            border-top: 1px solid #f0f0f0;
            display: flex;
            gap: 10px;
            background: #f8f9fa;
        }

        .btn-small {
            padding: 8px 16px;
            font-size: 14px;
            border-radius: 8px;
            flex: 1;
            text-align: center;
        }

        .btn-view {
            background: #2196F3;
            color: white;
        }

        .btn-view:hover {
            background: #1976D2;
        }

        .btn-edit {
            background: #FFC107;
            color: #333;
        }

        .btn-edit:hover {
            background: #FFA000;
        }

        .btn-delete {
            background: #F44336;
            color: white;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }

        .btn-delete:hover {
            background: #D32F2F;
        }

        /* Нет путешествий */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 15px;
            margin-top: 20px;
        }

        .empty-icon {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.3;
        }

        .empty-title {
            color: #666;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .empty-subtitle {
            color: #999;
            margin-bottom: 30px;
        }

        /* Модальное окно удаления */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            padding: 40px;
            border-radius: 15px;
            max-width: 500px;
            width: 90%;
            text-align: center;
        }

        .modal-title {
            color: #333;
            margin-bottom: 20px;
            font-size: 24px;
        }

        .modal-text {
            color: #666;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .modal-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .modal-btn {
            padding: 12px 30px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-family: inherit;
        }

        .modal-btn-cancel {
            background: #6c757d;
            color: white;
        }

        .modal-btn-confirm {
            background: #F44336;
            color: white;
        }

        .modal-btn:hover {
            transform: translateY(-2px);
        }

        /* Адаптивность */
        @media (max-width: 768px) {
            .header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
            
            .header-actions {
                flex-direction: column;
                width: 100%;
            }
            
            .btn {
                width: 100%;
                justify-content: center;
            }
            
            .travels-grid {
                grid-template-columns: 1fr;
            }
            
            .travel-card-footer {
                flex-direction: column;
            }
            
            .modal-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Шапка -->
        <div class="header">
            <h1>🎒 Мои путешествия</h1>
            <div class="header-actions">
                <% if (user) { %>
                    <div class="user-info">
                        <div class="avatar">
                            <%= user.username ? user.username.charAt(0).toUpperCase() : 'П' %>
                        </div>
                        <span><%= user.username %></span>
                    </div>
                <% } %>
                <a href="/add" class="btn btn-primary">
                    <span>➕</span> Новое путешествие
                </a>
                <a href="/" class="btn btn-secondary">
                    <span>🏠</span> На главную
                </a>
            </div>
        </div>

        <!-- Сообщения -->
        <% if (successMessage) { %>
            <div class="alert alert-success">
                ✅ <%= successMessage %>
            </div>
        <% } %>
        
        <% if (error) { %>
            <div class="alert alert-error">
                ❌ <%= error %>
            </div>
        <% } %>

        <!-- Список путешествий -->
        <% if (travels && travels.length > 0) { %>
            <div class="travels-grid">
                <% travels.forEach(travel => { %>
                    <div class="travel-card" data-id="<%= travel.id %>">
                        <div class="travel-card-header">
                            <div class="travel-card-title">
                                <%= travel.trip_name %>
                                <span class="travel-dates">
                                    <%= new Date(travel.start_date).toLocaleDateString('ru-RU') %>
                                    <% if (travel.end_date) { %>
                                        - <%= new Date(travel.end_date).toLocaleDateString('ru-RU') %>
                                    <% } %>
                                </span>
                            </div>
                        </div>
                        
                        <div class="travel-card-body">
                            <div class="travel-location">
                                <span>📍</span>
                                <%= travel.location %>
                            </div>
                            
                            <% if (travel.description) { %>
                                <p class="travel-description">
                                    <%= travel.description.length > 100 ? 
                                        travel.description.substring(0, 100) + '...' : 
                                        travel.description %>
                                </p>
                            <% } %>
                            
                            <div style="color: #999; font-size: 12px;">
                                Создано: <%= new Date(travel.created_at).toLocaleDateString('ru-RU') %>
                            </div>
                        </div>
                        
                        <div class="travel-card-footer">
                            <a href="/travels/<%= travel.id %>" class="btn-small btn-view">
                                👁️ Просмотр
                            </a>
                            <a href="/travelDetail" class="btn-small btn-edit">
                                ✏️ Редактировать
                            </a>
                            <button class="btn-small btn-delete">
                                🗑️ Удалить
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Состояние "нет путешествий" -->
            <div class="empty-state">
                <div class="empty-icon">🎒</div>
                <h2 class="empty-title">У вас пока нет путешествий</h2>
                <p class="empty-subtitle">
                    Создайте своё первое путешествие и начните планировать приключения!
                </p>
                <a href="/travels/create" class="btn btn-primary" style="margin-top: 20px;">
                    <span>➕</span> Создать первое путешествие
                </a>
            </div>
        <% } %>
    </div>

    <!-- Модальное окно удаления -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-content">
            <h2 class="modal-title">🗑️ Подтверждение удаления</h2>
            <p class="modal-text" id="deleteModalText">
                Вы действительно хотите удалить путешествие "<span id="travelName"></span>"?
                Это действие нельзя отменить.
            </p>
            <div class="modal-buttons">
                <button class="modal-btn modal-btn-cancel">
                    Отмена
                </button>
                <form id="deleteForm" method="POST" style="display: inline;">
                    <button type="submit" class="modal-btn modal-btn-confirm">
                        Да, удалить
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Подключаем отдельный JS файл -->
    <script src="/js/travelList.js"></script>
</body>
</html>