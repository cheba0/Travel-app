<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Добавить трату</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/public/icoplane.png" type="image/png">
</head>
<body>
    <div class="header" type="button" value="back" >
        <button class="nav" onclick="history.back()" style="background: none; border: none; cursor: pointer; padding: 12px; border-radius: 30px; display: flex; align-items: center; justify-content: center;"><svg class= onclick="history.back()" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg></button>
        
        
        <div class="add_exp_title">Добавление траты</div>
        <button onclick="location.href='/scan/<%= travel.id %>'" class="camera_btn" id="camera_btn"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M80-680v-200h200v80H160v120H80Zm0 600v-200h80v120h120v80H80Zm600 0v-80h120v-120h80v200H680Zm120-600v-120H680v-80h200v200h-80ZM700-260h60v60h-60v-60Zm0-120h60v60h-60v-60Zm-60 60h60v60h-60v-60Zm-60 60h60v60h-60v-60Zm-60-60h60v60h-60v-60Zm120-120h60v60h-60v-60Zm-60 60h60v60h-60v-60Zm-60-60h60v60h-60v-60Zm240-320v240H520v-240h240ZM440-440v240H200v-240h240Zm0-320v240H200v-240h240Zm-60 500v-120H260v120h120Zm0-320v-120H260v120h120Zm320 0v-120H580v120h120Z"/></svg></button>
    </div>
     <form id="expenseForm">
        <input type="hidden" id="tripId" name="trip_id" value="">
        <div class="add_exp_container">
            <div class="input_field">
            <input type="text" id="expenseName" name="expense_name" placeholder="Название">
        </div>

        <div class="input_field">
            <input type="date" id="expenseDate" name="date">
        </div>

        <div class="input_field">
            <input type="number" id="expenseAmount" name="amount" placeholder="Сумма">
        </div>

        <div class="input_field">
            <input type="text" placeholder="Локация">
        </div>

        <div class="file_upload">
            <label for="fileInput" class="file_upload_label">+ Добавить файлы</label>
            <input id="fileInput" type="file" multiple class="file_upload_input">
        </div>
        <div id="expenseMessage"></div>
        <button class="create_button" type="submit">Создать</button>
    </form>
    <script src="/js/creatingExpense.js"></script>
    <script>
        // Передаем данные из сервера в JavaScript
        window.travelData = {
            id: '<%= travel.id %>',
            name: '<%= travel.name %>',
        };
        // Функция для получения сегодняшней даты в формате YYYY-MM-DD
        function getTodayDate() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
        
        // Заполняем форму данными из URL параметров
        function fillFormFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            
            // Заполняем название
            if (urlParams.has('expense_name')) {
                const expenseName = decodeURIComponent(urlParams.get('expense_name'));
                document.getElementById('expenseName').value = expenseName;
                console.log('Заполнено название:', expenseName);
            }
            
            // Заполняем сумму
            if (urlParams.has('amount')) {
                const amount = decodeURIComponent(urlParams.get('amount'));
                document.getElementById('expenseAmount').value = amount;
                console.log('Заполнена сумма:', amount);
            }
            
            // Заполняем дату (если есть в URL, иначе сегодняшняя)
            let date = getTodayDate();
            if (urlParams.has('date') && urlParams.get('date')) {
                date = urlParams.get('date');
            }
            document.getElementById('expenseDate').value = date;
            console.log('Дата:', date);
        }
        
        // Вызываем заполнение при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM загружен, заполняем форму');
            fillFormFromUrl();
        });
    </script>
</body>
</html>