<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Маркетплейс</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="icon" href="/icoplane.png" type="image/png">
</head>

<body>
    <div class="market-header">
        <div class="categories">
            <a class="cat-item active">✈︎ Билеты</a>
            <a class="cat-item">⛱ Туры</a>
            <a class="cat-item">🏠︎ Жильё</a>
        </div>
    </div>

    <main class="market-container">
        <!-- БЛОК ПОИСКА ДЛЯ БИЛЕТОВ -->
        <div id="flightsSearchBlock" class="search-card">
            <div class="transport-selector">
                <button class="transport-option aviation active" data-transport="aviation">Авиа</button>
                <button class="transport-option train" data-transport="train">ЖД</button>
                <button class="transport-option bus" data-transport="bus">Автобусы</button>
            </div>

            <div class="twin-fields">
                <div class="search-field">
                    <label>Откуда</label>
                    <input type="text" id="originInput" placeholder="Город отправления">
                </div>
                <div class="search-field">
                    <label>Куда</label>
                    <input type="text" id="destinationInput" placeholder="Город прибытия">
                </div>
            </div>
            <div class="twin-fields">
                <div class="search-field">
                    <label>Туда</label>
                    <input type="date" id="departureDate" class="date-input">
                </div>
                <div class="search-field" id="returnDateField">
                    <label>Обратно</label>
                    <input type="date" id="returnDate" class="date-input">
                </div>
            </div>
            <button class="search-btn" id="searchTicketsBtn">Найти билеты</button>
        </div>

        <!-- СЕКЦИЯ АВИА -->
        <div id="aviationSection" class="transport-section">
            <div class="results-header">
                <h3>Авиабилеты</h3>
                <span class="results-count" id="flightsCount">найдено 0</span>
            </div>
            <div class="ticket-list" id="flightsList"></div>
        </div>

        <!-- СЕКЦИЯ ЖД -->
        <div id="trainsSection" class="transport-section" style="display: none;">
            <div class="results-header">
                <h3>Ж/Д билеты</h3>
                <span class="results-count" id="trainsCount">найдено 0</span>
            </div>
            <div class="train-list" id="trainsList"></div>
        </div>

        <!-- СЕКЦИЯ АВТОБУСЫ -->
        <div id="busesSection" class="transport-section" style="display: none;">
            <div class="results-header">
                <h3>Автобусы</h3>
                <span class="results-count" id="busesCount">найдено 0</span>
            </div>
            <div class="bus-list" id="busesList"></div>
        </div>

        <!-- БЛОК ПОИСКА ДЛЯ ТУРОВ -->
        <div id="toursSearchBlock" class="search-card" style="display: none;">
            <div class="twin-fields">
                <div class="search-field">
                    <label>Откуда</label>
                    <input type="text" id="tourOrigin" placeholder="Город вылета">
                </div>
                <div class="search-field">
                    <label>Куда</label>
                    <input type="text" id="tourDestination" placeholder="Направление">
                </div>
            </div>
            <div class="twin-fields">
                <div class="search-field">
                    <label>Дата вылета</label>
                    <input type="date" id="tourDate">
                </div>
                <div class="search-field">
                    <label>Количество ночей</label>
                    <input type="text" id="tourNights" placeholder="7 ночей">
                </div>
            </div>
            <button class="search-btn" id="searchToursBtn">Найти туры</button>
        </div>

        <!-- СЕКЦИЯ ТУРОВ -->
        <div id="toursSection" class="tours-list" style="display: none;">
            <div class="results-header">
                <h3>Найденные туры</h3>
                <span class="results-count" id="toursCount">найдено 0</span>
            </div>
            <div id="toursList"></div>
        </div>

        <!-- БЛОК ПОИСКА ДЛЯ ЖИЛЬЯ -->
        <div id="hotelsSearchBlock" class="search-card" style="display: none;">
            <div class="twin-fields">
                <div class="search-field">
                    <label>Страна</label>
                    <select class="search-field" id="hotelCountrySelect">
                        <!-- <option value="Выберите страну"></option> -->
                    </select>
                </div>
                <div class="search-field">
                    <label>Город</label>
                    <select id="hotelCitySelect" disabled>
                        <!-- <option value=""></option> -->
                    </select>
                </div>
            </div>
            <div class="twin-fields">
                <div class="search-field">
                    <label>Заезд</label>
                    <input type="date" id="hotelCheckIn">
                </div>
                <div class="search-field">
                    <label>Выезд</label>
                    <input type="date" id="hotelCheckOut">
                </div>
            </div>
            <div class="twin-fields">
                <div class="search-field">
                    <label>Гостей</label>
                    <input type="number" id="hotelAdults" value="2" min="1" max="10">
                </div>
                <div class="search-field">
                    <label>Валюта</label>
                    <select id="hotelCurrency">
                        <option value="RUB">RUB</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </div>
            </div>
            <button class="search-btn" id="searchHotelsBtn">Найти жильё</button>
        </div>

        <!-- СЕКЦИЯ ЖИЛЬЯ -->
        <div id="hotelsSection" class="hotels-list" style="display: none;">
            <div class="results-header">
                <h3>Найденное жилье</h3>
                <span class="results-count" id="hotelsCount">найдено 0</span>
            </div>
            <div id="hotelsList"></div>
        </div>

        <div id="travelSelectModal" class="modal" style="display: none;">
            <div class="modal-content">
                <span class="close-modal">&times;</span>
                <h3>Выберите путешествие</h3>
                <div id="travelList"></div>
            </div>
        </div>
    </main>

    <div class="bottom_navigation">
