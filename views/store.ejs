<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Маркетплейс</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="icon" href="/public/icoplane.png" type="image/png">
</head>
<body>
    <div class="market-header">
    <div class="categories">
        <a href="store.html"class="cat-item active">✈︎ Билеты</a>
        <a href="tours.html" class="cat-item">⛱ Туры</a>
        <a href="hotel.html" class="cat-item">🏠︎ Жильё</a>
    </div>
</div>

<main class="market-container">
    <div class="search-card">
        <div class="twin-fields">
            <div class="search-field">
                <label>Откуда</label>
                <input type="text" placeholder="Город вылета">
            </div>
            <div class="search-field">
                <label>Куда</label>
                <input type="text" placeholder="Город прилёта">
            </div>
        </div>
        <div class="twin-fields">
            <div class="search-field">
                <label>Туда</label>
                <input type="date" class="date-input">
            </div>
            <div class="search-field">
                <label>Обратно</label>
                <input type="date" class="date-input">
            </div>
        </div>
        <button class="search-btn">🔍︎ Найти билеты</button>
    </div>

    <div class="results-header">
        <h3>✈︎ Билеты</h3>
        <span class="results-count">найдено 2</span>
    </div>

    <div class="ticket-list">
        <!-- БИЛЕТ №1: прямой рейс Москва → Барселона -->
        <div class="ticket-card">
            <div class="ticket-airline">
                <span class="airline-name">Аэрофлот</span>
                <span class="flight-number">SU 2602</span>
            </div>
            <div class="route-main">
                <div class="city-block">
                    <div class="city-code">SVO</div>
                    <div class="city-name">Москва</div>
                    <div class="time">09:25</div>
                </div>
                <div class="flight-duration">
                    4ч 25м
                    <div class="stops-badge">✈︎ Прямой рейс</div>
                </div>
                <div class="city-block">
                    <div class="city-code">BCN</div>
                    <div class="city-name">Барселона</div>
                    <div class="time">12:50</div>
                </div>
            </div>
            <div class="ticket-info">
                <div class="price-tag">18 990 <small>₽</small></div>
                <div class="luggage-badge">
                    <span>𖠩 1×23кг</span>
                </div>
            </div>
        </div>

        <!-- БИЛЕТ №2: с 1 пересадкой (Стамбул) -->
        <div class="ticket-card">
            <div class="ticket-airline">
                <span class="airline-name">Turkish Airlines</span>
                <span class="flight-number">TK 412</span>
            </div>
            <div class="route-main">
                <div class="city-block">
                    <div class="city-code">VKO</div>
                    <div class="city-name">Москва</div>
                    <div class="time">04:55</div>
                </div>
                <div class="flight-duration">
                    7ч 25м
                    <div class="stops-badge">↪ 1 пересадка (Стамбул)</div>
                </div>
                <div class="city-block">
                    <div class="city-code">BCN</div>
                    <div class="city-name">Барселона</div>
                    <div class="time">09:20</div>
                </div>
            </div>
            <div class="ticket-info">
                <div class="price-tag">15 750 <small>₽</small></div>
                <div class="luggage-badge">
                    <span>𖠩 2×23кг</span>
                </div>
            </div>
        </div>
    </div>

</main>


