    </div>

    <script>
        // ========== 1. РАСКРЫВАЮЩИЕСЯ МЕНЮ ДЛЯ КАРТОЧЕК ==========
        function closeAllMenus() {
            document.querySelectorAll('.ticket-card, .train-card, .bus-card, .tour-card, .hotel-card').forEach(card => {
                card.classList.remove('expanded');
            });
        }

        // Функция для добавления обработчиков на динамически создаваемые карточки
        function addExpandHandlers() {
            // Авиабилеты
            document.querySelectorAll('.ticket-card').forEach(card => {
                if (card.hasAttribute('data-handler')) return;
                card.setAttribute('data-handler', 'true');
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.btn-website') || e.target.closest('.btn-travel')) return;
                    if (card.classList.contains('expanded')) {
                        card.classList.remove('expanded');
                    } else {
                        closeAllMenus();
                        card.classList.add('expanded');
                    }
                });
            });

            // ЖД билеты
            document.querySelectorAll('.train-card').forEach(card => {
                if (card.hasAttribute('data-handler')) return;
                card.setAttribute('data-handler', 'true');
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.btn-website') || e.target.closest('.btn-travel')) return;
                    if (card.classList.contains('expanded')) {
                        card.classList.remove('expanded');
                    } else {
                        closeAllMenus();
                        card.classList.add('expanded');
                    }
                });
            });

            // Автобусы
            document.querySelectorAll('.bus-card').forEach(card => {
                if (card.hasAttribute('data-handler')) return;
                card.setAttribute('data-handler', 'true');
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.btn-website') || e.target.closest('.btn-travel')) return;
                    if (card.classList.contains('expanded')) {
                        card.classList.remove('expanded');
                    } else {
                        closeAllMenus();
                        card.classList.add('expanded');
                    }
                });
            });

            // Туры
            document.querySelectorAll('.tour-card').forEach(card => {
                if (card.hasAttribute('data-handler')) return;
                card.setAttribute('data-handler', 'true');
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.btn-website') || e.target.closest('.btn-travel')) return;
                    if (card.classList.contains('expanded')) {
                        card.classList.remove('expanded');
                    } else {
                        closeAllMenus();
                        card.classList.add('expanded');
                    }
                });
            });

            // Жилье
            document.querySelectorAll('.hotel-card').forEach(card => {
                if (card.hasAttribute('data-handler')) return;
                card.setAttribute('data-handler', 'true');
                card.addEventListener('click', function(e) {
                    if (e.target.closest('.btn-website') || e.target.closest('.btn-travel')) return;
                    if (card.classList.contains('expanded')) {
                        card.classList.remove('expanded');
                    } else {
                        closeAllMenus();
                        card.classList.add('expanded');
                    }
                });
            });
        }

        // ========== 2. ПЕРЕКЛЮЧЕНИЕ МЕЖДУ АВИА/ЖД/АВТОБУСАМИ ==========
        const transportBtns = document.querySelectorAll('.transport-option');
        const aviationSection = document.querySelector('#aviationSection');
        const trainsSection = document.querySelector('#trainsSection');
        const busesSection = document.querySelector('#busesSection');

        function switchTransport(transport) {
            if (aviationSection) aviationSection.style.display = 'none';
            if (trainsSection) trainsSection.style.display = 'none';
            if (busesSection) busesSection.style.display = 'none';
            
            if (transport === 'aviation' && aviationSection) aviationSection.style.display = 'block';
            else if (transport === 'train' && trainsSection) trainsSection.style.display = 'block';
            else if (transport === 'bus' && busesSection) busesSection.style.display = 'block';
        }

        transportBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                transportBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                switchTransport(this.getAttribute('data-transport'));
            });
        });

        // ========== 3. ПЕРЕКЛЮЧЕНИЕ МЕЖДУ БИЛЕТЫ/ТУРЫ/ЖИЛЬЁ (ШАПКА) ==========
        const categoryBtns = document.querySelectorAll('.cat-item');
        const flightsSearchBlock = document.getElementById('flightsSearchBlock');
        const toursSearchBlock = document.getElementById('toursSearchBlock');
        const hotelsSearchBlock = document.getElementById('hotelsSearchBlock');
        const flightsMainBlock = document.getElementById('aviationSection');
        const trainsMainBlock = document.getElementById('trainsSection');
        const busesMainBlock = document.getElementById('busesSection');
        const toursMainBlock = document.getElementById('toursSection');
        const hotelsMainBlock = document.getElementById('hotelsSection');

        function switchCategoryTab(tab) {
            // Скрываем поисковые блоки
            if (flightsSearchBlock) flightsSearchBlock.style.display = 'none';
            if (toursSearchBlock) toursSearchBlock.style.display = 'none';
            if (hotelsSearchBlock) hotelsSearchBlock.style.display = 'none';
            
            // Скрываем секции результатов
            if (flightsMainBlock) flightsMainBlock.style.display = 'none';
            if (trainsMainBlock) trainsMainBlock.style.display = 'none';
            if (busesMainBlock) busesMainBlock.style.display = 'none';
            if (toursMainBlock) toursMainBlock.style.display = 'none';
            if (hotelsMainBlock) hotelsMainBlock.style.display = 'none';
            
            if (tab === 'flights') {
                if (flightsSearchBlock) flightsSearchBlock.style.display = 'block';
                if (flightsMainBlock) flightsMainBlock.style.display = 'block';
                
                const aviationBtn = document.querySelector('.transport-option.aviation');
                const trainBtn = document.querySelector('.transport-option.train');
                const busBtn = document.querySelector('.transport-option.bus');
                if (aviationBtn) aviationBtn.classList.add('active');
                if (trainBtn) trainBtn.classList.remove('active');
                if (busBtn) busBtn.classList.remove('active');
                switchTransport('aviation');
                toggleReturnDateField();
            } else if (tab === 'tours') {
                if (toursSearchBlock) toursSearchBlock.style.display = 'block';
                if (toursMainBlock) toursMainBlock.style.display = 'block';
            } else if (tab === 'hotels') {
                if (hotelsSearchBlock) hotelsSearchBlock.style.display = 'block';
                if (hotelsMainBlock) hotelsMainBlock.style.display = 'block';
            }
            
            categoryBtns.forEach(btn => {
                btn.classList.remove('active');
                if ((tab === 'flights' && btn.innerText.includes('Билеты')) ||
                    (tab === 'tours' && btn.innerText.includes('Туры')) ||
                    (tab === 'hotels' && btn.innerText.includes('Жильё'))) {
                    btn.classList.add('active');
                }
            });
        }
        
        categoryBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                if (this.innerText.includes('Билеты')) switchCategoryTab('flights');
                else if (this.innerText.includes('Туры')) switchCategoryTab('tours');
                else if (this.innerText.includes('Жильё')) switchCategoryTab('hotels');
            });
        });
        
        // По умолчанию показываем Билеты
        switchCategoryTab('flights');

        // Показать/скрыть поле "Обратно" в зависимости от выбранного транспорта
        function toggleReturnDateField() {
            const activeTransport = document.querySelector('.transport-option.active');
            const transport = activeTransport ? activeTransport.getAttribute('data-transport') : 'aviation';
            const returnDateField = document.getElementById('returnDateField');
            const returnDateInput = document.getElementById('returnDate');
            
            if (transport === 'aviation') {
                if (returnDateField) returnDateField.style.display = 'block';
            } else {
                if (returnDateField) returnDateField.style.display = 'none';
                if (returnDateInput) returnDateInput.value = '';
            }
        }

        // Добавляем обработчики на кнопки транспорта
        const transportBtnsForReturn = document.querySelectorAll('.transport-option');
        if (transportBtnsForReturn.length > 0) {
            transportBtnsForReturn.forEach(btn => {
                btn.addEventListener('click', function() {
                    setTimeout(toggleReturnDateField, 50);
                });
            });
        }

        // Вызываем после полной загрузки страницы
        setTimeout(() => {
            toggleReturnDateField();
        }, 100);

        // Закрытие модального окна
        document.querySelector('.close-modal')?.addEventListener('click', () => {
            document.getElementById('travelSelectModal').style.display = 'none';
        });

        // Закрытие при клике вне окна
        window.addEventListener('click', (e) => {
            const modal = document.getElementById('travelSelectModal');
            if (e.target === modal) {
                modal.style.display = 'none';
            }
        });
        
    </script>

    <!-- Подключаем существующие JS файлы с функциями поиска -->
    <script src="/js/tickets.js"></script>
    
    <script>
        // ========== ПОДКЛЮЧЕНИЕ КНОПОК ПОИСКА К СУЩЕСТВУЮЩИМ ФУНКЦИЯМ ==========
        // Ждём загрузки всех скриптов
        setTimeout(() => {
            // Кнопка поиска билетов
            const searchBtn = document.getElementById('searchTicketsBtn');
            if (searchBtn && typeof searchFlights !== 'undefined') {
                searchBtn.addEventListener('click', () => {
                    const activeTransport = document.querySelector('.transport-option.active');
                    const transport = activeTransport ? activeTransport.getAttribute('data-transport') : 'aviation';
                    if (transport === 'aviation' && typeof searchFlights === 'function') searchFlights();
                    else if (transport === 'train' && typeof searchTrains === 'function') searchTrains();
                    else if (transport === 'bus' && typeof searchBuses === 'function') searchBuses();
                });
            }
            
            // Кнопка поиска отелей
            const hotelSearchBtn = document.getElementById('searchHotelsBtn');
            if (hotelSearchBtn && typeof searchHotels === 'function') {
                hotelSearchBtn.addEventListener('click', () => {
                    searchHotels(1);  // 
                });
            }
            
            // Кнопка поиска туров (пока заглушка)
            const toursSearchBtn = document.getElementById('searchToursBtn');
            if (toursSearchBtn) {
                toursSearchBtn.addEventListener('click', () => {
                    alert('Функция поиска туров в разработке');
                });
            }
            
            // Функции для загрузки стран/городов отелей
            if (typeof loadHotelCountries === 'function') {
                loadHotelCountries();
            }
            
            const countrySelect = document.getElementById('hotelCountrySelect');
            if (countrySelect && typeof loadHotelCities === 'function') {
                countrySelect.addEventListener('change', (e) => {
                    if (e.target.value) loadHotelCities(e.target.value);
                });
            }
            
            // Добавляем обработчики для раскрывающихся меню после загрузки результатов
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.addedNodes.length) {
                        addExpandHandlers();
                    }
                });
            });
            
            observer.observe(document.getElementById('flightsList'), { childList: true, subtree: true });
            observer.observe(document.getElementById('trainsList'), { childList: true, subtree: true });
            observer.observe(document.getElementById('busesList'), { childList: true, subtree: true });
            observer.observe(document.getElementById('hotelsList'), { childList: true, subtree: true });
            
            addExpandHandlers();
        }, 100);

        
    </script>
</body>

</html>