<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мои путешествия</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="header">
        <div class="icon">ЛОГО</div>
        <div class="search"><input type="text" placeholder="Поиск..."></div>
    </div>

    <div class="main">
        <div class="ad">
            Реклама
        </div>

        <div>
            <h1>Мои путешествия</h1>
        </div>

<!-- Блок с пользователями из БД -->
        <div class="users-list">
            <h3>Пользователи из базы данных:</h3>
            <% if (users && users.length > 0) { %>
                <% users.forEach(function(user) { %>
                    <div class="user-item">
                        <strong>ID:</strong> <%= user.id %> | 
                        <strong>Имя:</strong> <%= user.name || 'Не указано' %> | 
                        <strong>Email:</strong> <%= user.email || 'Не указан' %>
                    </div>
                <% }); %>
            <% } else { %>
                <p>Нет данных о пользователях</p>
            <% } %>
        </div>

        <!-- Блок с путешествиями из БД -->
        <div class="users-list">
            <h3>Путешествия из базы данных:</h3>
            <% if (trips && trips.length > 0) { %>
                <% trips.forEach(function(trip) { %>
                    <div class="user-item">
                        <strong>ID:</strong> <%= trip.id %> | 
                        <strong>Название:</strong> <%= trip.title || 'Без названия' %> | 
                        <strong>Даты:</strong> <%= trip.start_date %> - <%= trip.end_date %>
                    </div>
                <% }); %>
            <% } else { %>
                <p>Нет данных о путешествиях</p>
            <% } %>
        </div>

        <span class="year">2025</span>
        <div class="card">
            <div class="card-left">
                <div class="title">Шашлычки</div>
            </div>
            <div class="dates">1.02 - 2.02</div>
        </div>

        <span class="year">2024</span>
        <div class="card">
            <div class="card-left">
                <div class="title">Какое-то очень длинное наз...</div>
            </div>
            <div class="dates">1.02 - 2.02</div>
        </div>
    </div>

