<!-- views/scan.ejs -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Permissions-Policy" content="camera=*">
    <title>Сканирование чека - Travel App</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="scan_header">
        <svg onclick="history.back()" class="back-btn" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg>
        
        <div class="header-content">
        <h1>Сканирование чека</h1>
        <p>Путешествие #<%= travelId %></p>
        </div>
    </div>
    
    <div class="instructions">
        <p>1. Наведите камеру на QR-код чека</p>
        <p>2. Удерживайте чек в рамке</p>
        <p>3. Расход добавится автоматически</p>
    </div>
    
    <div class="scanner-container">
        <video id="scanner-video"></video>
        <div class="scanner-overlay"></div>
    </div>
    
    <div class="scan_status" id="status">
        Камера не активирована
    </div>
    
    <div class="controls">
        <button class="start-btn" id="start-btn">📷 Запустить камеру</button>
        <button class="stop-btn" id="stop-btn" disabled>⏹ Остановить</button>
    </div>
    
    <div id="result"></div>

    <!-- Подключаем библиотеку jsQR -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    
    <script>

    const travelId = '<%= travelId %>';
    let scannerActive = false;
    let videoStream = null;
    
    // Элементы
    const video = document.getElementById('scanner-video');
    const startBtn = document.getElementById('start-btn');
    const stopBtn = document.getElementById('stop-btn');
    const resultDiv = document.getElementById('result');
    const statusDiv = document.getElementById('status');
    
    function updateStatus(message, type = 'info') {
        if (!statusDiv) return;
        statusDiv.textContent = message;
        statusDiv.className = `scan_status ${type}`;
    }

    // ФУНКЦИЯ ПРОВЕРКИ ПОДДЕРЖКИ КАМЕРЫ
    async function checkCameraSupport() {
        console.log('🔍 Проверка камеры...');
        console.log('📍 Протокол:', location.protocol);
        console.log('📍 Хост:', location.hostname);
        
        // 1. Проверка HTTPS (на глобальном сервере)
        if (location.protocol !== 'https:' && location.hostname !== 'localhost' && !location.hostname.includes('192.168.')) {
            updateStatus('❌ Камера требует HTTPS. Используйте https://', 'error');
            if (startBtn) startBtn.disabled = true;
            return false;
        }
    
        // 2. Проверка API
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            updateStatus('❌ Ваш браузер не поддерживает камеру', 'error');
            if (startBtn) startBtn.disabled = true;
            return false;
        }
        
        // 3. Проверка наличия камер
        try {
            const devices = await navigator.mediaDevices.enumerateDevices();
            const videoDevices = devices.filter(d => d.kind === 'videoinput');
            console.log('📹 Найдено камер:', videoDevices.length);
            
            if (videoDevices.length === 0) {
                updateStatus('❌ Камера не обнаружена', 'error');
                if (startBtn) startBtn.disabled = true;
                return false;
            }
            
            updateStatus('✅ Камера готова. Нажмите "Запустить камеру"', 'info');
            if (startBtn) startBtn.disabled = false;
            return true;
            
        } catch (err) {
            console.warn('⚠️ Не удалось получить список устройств');
            return true;
        }
    }

    // ЗАПУСК КАМЕРЫ С ПРОВЕРКОЙ РАЗРЕШЕНИЙ
    startBtn.addEventListener('click', async () => {
        try {
            updateStatus('Запрос доступа к камере...', 'info');
            
            // ПРОБУЕМ РАЗНЫЕ НАСТРОЙКИ
            let stream;
            try {
                // Сначала пробуем с environment (задняя камера)
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { 
                        facingMode: { ideal: 'environment' },
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    }
                });
            } catch (e) {
                console.log('⚠️ Не удалось получить заднюю камеру, пробуем любую');
                // Если не получается, пробуем без настроек
                stream = await navigator.mediaDevices.getUserMedia({ 
                    video: true 
                });
            }
            
            video.srcObject = stream;
            videoStream = stream;
            
            video.setAttribute('playsinline', 'true');
            video.setAttribute('autoplay', 'true');
            video.setAttribute('muted', 'true');
            
            // Ждем готовности видео
            await new Promise((resolve) => {
                video.onloadedmetadata = () => {
                    video.play().then(resolve);
                };
            });
            
            scannerActive = true;
            updateStatus('✅ Камера активна. Наведите на QR-код', 'success');
            
            startBtn.disabled = true;
            stopBtn.disabled = false;
            
            optimizedScan();
            
        } catch (error) {
            console.error('❌ Ошибка камеры:', error);
            
            let errorMsg = '❌ Ошибка доступа к камере';
            if (error.name === 'NotAllowedError' || error.message.includes('Permission')) {
                errorMsg = '❌ Доступ запрещен. Разрешите камеру в настройках браузера.';
            } else if (error.name === 'NotFoundError') {
                errorMsg = '❌ Камера не найдена';
            } else if (error.name === 'NotReadableError') {
                errorMsg = '❌ Камера занята другим приложением';
            } else if (error.name === 'OverconstrainedError') {
                errorMsg = '❌ Камера не поддерживает требуемые параметры';
            }
            
            updateStatus(errorMsg, 'error');
        }
    });
    
    // ОСТАНОВКА КАМЕРЫ
    stopBtn.addEventListener('click', () => {
        if (videoStream) {
            videoStream.getTracks().forEach(track => track.stop());
            videoStream = null;
        }
        scannerActive = false;
        startBtn.disabled = false;
        stopBtn.disabled = true;
        updateStatus('Камера остановлена', 'info');
        if (resultDiv) resultDiv.style.display = 'none';
    });
    
    // ОПТИМИЗИРОВАННОЕ СКАНИРОВАНИЕ
    function optimizedScan() {
        if (!scannerActive) return;
        
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        
        let scanCount = 0;
        
        function scan() {
            if (!scannerActive) return;
            
            if (video && video.readyState === video.HAVE_ENOUGH_DATA) {
                try {
                    const targetWidth = 320;
                    const targetHeight = 240;
                    
                    canvas.width = targetWidth;
                    canvas.height = targetHeight;
                    
                    ctx.drawImage(video, 0, 0, targetWidth, targetHeight);
                    
                    scanCount++;
                    if (scanCount % 2 !== 0) {
                        requestAnimationFrame(scan);
                        return;
                    }
                    
                    const imageData = ctx.getImageData(0, 0, targetWidth, targetHeight);
                    
                    const code = jsQR(imageData.data, imageData.width, imageData.height, {
                        inversionAttempts: 'dontInvert'
                    });
                    
                    if (code) {
                        console.log('✅ QR НАЙДЕН!');
                        if (navigator.vibrate) navigator.vibrate(100);
                        sendQRCode(code.data);
                        return;
                    }
                    
                    if (scanCount % 60 === 0) {
                        updateStatus('🔍 Сканирование...', 'info');
                    }
                    
                } catch (e) {
                    // Игнорируем ошибки
                }
            }
            
            requestAnimationFrame(scan);
        }
        
        scan();
    }
    
    // ОТПРАВКА НА СЕРВЕР
    async function sendQRCode(qrData) {
        updateStatus('⏳ Обработка...', 'info');
        
        try {
            const response = await fetch('/process-receipt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    qrRawData: qrData,
                    travelId: travelId
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                updateStatus('✅ Готово!', 'success');
                
                if (resultDiv) {
                    resultDiv.innerHTML = `
                        <div style="background: #4CAF50; color: white; padding: 15px; border-radius: 8px;">
                            <h3 style="margin: 0 0 10px 0;">✅ Добавлено!</h3>
                            <p style="font-size: 24px; margin: 0;">${result.expense.amount} ₽</p>
                            <button onclick="location.reload()" 
                                    style="background: white; color: #4CAF50; border: none; 
                                           padding: 8px 16px; border-radius: 4px; margin-top: 10px;">
                                Ещё
                            </button>
                        </div>
                    `;
                    resultDiv.style.display = 'block';
                }
                
                setTimeout(() => stopBtn?.click(), 1500);
            } else {
                throw new Error(result.message);
            }
            
        } catch (error) {
            console.error(error);
            updateStatus('❌ Ошибка', 'error');
        }
    }
    
    // ТЕСТОВАЯ ФУНКЦИЯ
 
    
    // ЗАПУСК ПРОВЕРКИ ПРИ ЗАГРУЗКЕ
    document.addEventListener('DOMContentLoaded', () => {
        checkCameraSupport();
    });
</script>
</body>
</html>