<!-- views/scan.ejs -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Сканирование чека - Travel App</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="scan_header">
        <svg onclick="history.back()" class="back-btn" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg>
        
        <div class="header-content">
        <h1>Сканирование чека</h1>
        <p>Путешествие #<%= travelId %></p>
        </div>
    </div>
    
    <div class="instructions">
        <p>1. Наведите камеру на QR-код чека</p>
        <p>2. Удерживайте чек в рамке</p>
        <p>3. Расход добавится автоматически</p>
    </div>
    
    <div class="scanner-container">
        <video id="scanner-video"></video>
        <div class="scanner-overlay"></div>
    </div>
    
    <div class="scan_status" id="status">
        Камера не активирована
    </div>
    
    <div class="controls">
        <button class="start-btn" id="start-btn">📷 Запустить камеру</button>
        <button class="stop-btn" id="stop-btn" disabled>⏹ Остановить</button>
    </div>
    
    <div id="result"></div>

    <!-- Подключаем библиотеку jsQR -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    
    <script>
        const travelId = '<%= travelId %>';
        let scannerActive = false;
        let videoStream = null;
        
        // Элементы
        const video = document.getElementById('scanner-video');
        const startBtn = document.getElementById('start-btn');
        const stopBtn = document.getElementById('stop-btn');
        const resultDiv = document.getElementById('result');
        const statusDiv = document.getElementById('status');
        
        // Обновление статуса
        function updateStatus(message, type = 'info') {
            statusDiv.textContent = message;
            statusDiv.className = `scan_status ${type}`;
        }
        
        // Запуск камеры
        startBtn.addEventListener('click', async () => {
            try {
                updateStatus('Запрос доступа к камере...', 'info');
                
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { 
                        facingMode: 'environment',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                });
                
                video.srcObject = stream;
                videoStream = stream;
                scannerActive = true;
                
                video.play().then(() => {
                    updateStatus('Камера активна. Наведите на QR-код', 'success');
                });
                
                startBtn.disabled = true;
                stopBtn.disabled = false;
                
                startScanning();
                
            } catch (error) {
                let errorMsg = 'Ошибка камеры';
                
                if (error.name === 'NotAllowedError') {
                    errorMsg = 'Доступ к камере запрещен. Разрешите доступ в настройках браузера.';
                } else if (error.name === 'NotFoundError') {
                    errorMsg = 'Камера не найдена';
                } else if (error.name === 'NotReadableError') {
                    errorMsg = 'Камера используется другим приложением';
                }
                
                updateStatus(errorMsg, 'error');
                showResult(errorMsg, 'error');
            }
        });
        
        // Остановка камеры
        stopBtn.addEventListener('click', () => {
            if (videoStream) {
                videoStream.getTracks().forEach(track => track.stop());
                videoStream = null;
            }
            scannerActive = false;
            startBtn.disabled = false;
            stopBtn.disabled = true;
            updateStatus('Камера остановлена', 'info');
            resultDiv.style.display = 'none';
        });
        
        // Функция сканирования
        // В scan.ejs, в функции startScanning()
function startScanning() {
    if (!scannerActive) return;
    
    // СОЗДАЕМ CANVAS С АТРИБУТОМ willReadFrequently
    const canvas = document.createElement('canvas');
    canvas.willReadFrequently = true; // ← ДОБАВЬТЕ ЭТУ СТРОКУ
    const ctx = canvas.getContext('2d');
    
    function scan() {
        if (!scannerActive) return;
        
        if (video.readyState === video.HAVE_ENOUGH_DATA) {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            
            try {
                const code = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: 'dontInvert'
                });
                
                if (code) {
                    console.log('QR найден:', code.data);
                    processQRCode(code.data);
                    return;
                }
            } catch (e) {
                console.log('Ошибка декодирования:', e);
            }
        }
        
        requestAnimationFrame(scan);
    }
    
    scan();
}
        
        // Обработка QR-кода
        async function processQRCode(qrData) {
            console.log('🚀 === НАЧАЛО processQRCode ===');
            console.log('📱 QR данные:', qrData);
            console.log('📏 Длина:', qrData.length);
            
            updateStatus('Чек обнаружен! Обработка...', 'info');
            
            try {
                console.log('1. Формируем запрос...');
                const requestBody = {
                qrRawData: qrData,
                travelId: travelId
                };
                
                console.log('2. Данные для отправки:', requestBody);
                
                console.log('3. Отправляем fetch запрос...');
                const response = await fetch('/process-receipt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestBody)
                });
                
                console.log('4. Ответ получен. Статус:', response.status);
                console.log('5. Заголовки ответа:', response.headers);
                
                const responseText = await response.text();
                console.log('6. Полный текст ответа:', responseText);
                
                console.log('7. Парсим JSON...');
                let result;
                try {
                result = JSON.parse(responseText);
                console.log('8. JSON распарсен:', result);
                } catch (parseError) {
                console.error('❌ Ошибка парсинга JSON:', parseError);
                console.error('❌ Текст ответа:', responseText);
                throw new Error('Сервер вернул невалидный JSON');
                }
                
                console.log('9. Проверяем success...');
                if (result.success === false) {
                console.error('❌ Сервер вернул ошибку:', result.message);
                showResult(`Ошибка: ${result.message}`, 'error');
                return;
                }
                
                console.log('10. Проверяем наличие expense...');
                if (!result.expense) {
                console.warn('⚠️ expense отсутствует в ответе:', result);
                showResult('Данные о расходе не получены', 'warning');
                return;
                }
                
                console.log('11. Всё успешно! expense:', result.expense);
                updateStatus('✅ Чек сохранен!', 'success');
                
                // Показываем результат
                showResult(`
                <div class="success">
                    <h3>✅ Чек успешно обработан!</h3>
                    <p><strong>Сумма:</strong> ${result.expense.amount} руб.</p>
                    <p><strong>Описание:</strong> ${result.expense.description || 'Чек покупки'}</p>
                    <button onclick="location.reload()">Сканировать ещё</button>
                </div>
                `, 'success');
                
                // Останавливаем сканер
                setTimeout(() => {
                if (stopBtn && !stopBtn.disabled) {
                    console.log('12. Автоматически останавливаем сканер...');
                    stopBtn.click();
                }
                }, 3000);
                
            } catch (error) {
                console.error('🔥 КРИТИЧЕСКАЯ ОШИБКА:', error);
                console.error('🔥 Stack:', error.stack);
                
                updateStatus('🔥 Ошибка', 'error');
                showResult(`Ошибка: ${error.message}`, 'error');
            }
            
            console.log('🏁 === КОНЕЦ processQRCode ===');
            }
        
        // Показать результат
        function showResult(message, type) {
            resultDiv.innerHTML = message;
            resultDiv.className = type;
            resultDiv.style.display = 'block';
        }
        
        // Проверка поддержки камеры
        window.addEventListener('load', () => {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                updateStatus('Ваш браузер не поддерживает доступ к камере', 'error');
                startBtn.disabled = true;
            }
        });
    </script>
</body>
</html>