<div id="editExpenseModal" class="modal" style="display: none;">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h3>Редактировать трату</h3>
    <form id="editExpenseForm">
      <input type="hidden" id="expenseId" name="id">
      <input type="hidden" id="tripId" name="trip_id" value="<%= travel.id %>">

      <label>Название:</label>
      <input type="text" id="expense_name" name="expense_name" required>

      <label>Сумма:</label>
      <input type="number" step="0.01" id="amount" name="amount" required>

      <label>Дата:</label>
      <input type="date" id="date" name="date" required>

      <label>Описание:</label>
      <textarea id="description" name="description"></textarea>

      <!-- Категория (опционально) -->
      <label>Категория:</label>
      <select id="category_id" name="category_id">
        <option value="">Без категории</option>
        <!-- Здесь можно подгрузить категории -->
      </select>

      <button type="submit">Сохранить</button>
    </form>
  </div>
</div>