<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создание путешествия</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div create_travel_container>
        <div class="create_travel_header"><div class="create_travel_title">Создание путешествия</div></div>
        
        <label class="image_upload_block">
            <input type="file" id="imageInput" accept="image/*" hidden>
             <div id="uploadIcon" class="upload-icon">
                <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#434343">
                    <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Zm-40 80v-560 560Z"/>
                </svg>
            </div>
            <img id="preview" class="image_preview" style="display: none;">
        </label>

        <div class="input_field">
            <input id="tripName" type="text" placeholder="Название">
        </div>

         <div class="input_field">
            <input id="tripLocation" type="text" placeholder="Локация">
        </div>

        <div class="input_field">
            <input id="tripDates" type="text" placeholder="Даты поездки" readonly>
        </div>

        <div class="description_block">
            <textarea id="tripDescription" placeholder="Описание"></textarea>
        </div>

        <button class="create_button" id="createBtn">Создать</button>
    </div>

    <div class="bottom_navigation">
        <button class="nav" onclick="location.href='/'"><svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#e3e3e3"><path d="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z"/></svg></button>
        <button class="nav_active" onclick="location.href='add'"><svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#e3e3e3"><path d="M440-280h80v-160h160v-80H520v-160h-80v160H280v80h160v160Zm40 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg></button>
        <button class="nav" onclick="location.href='profile'"><svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#e3e3e3"><path d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm240-320q33 0 56.5-23.5T560-640q0-33-23.5-56.5T480-720q-33 0-56.5 23.5T400-640q0 33 23.5 56.5T480-560Zm0-80Zm0 400Z"/></svg></button>
    </div>
    <script src="/js/profileCheck.js"></script>
</body>
</html>