    <!-- Передача данных сервера в JavaScript -->
<script>
    window.travelData = {
        id: '<%= travel.id %>',
        name: '<%= travel.name %>',
        currency: '<%= travel.currency || "RUB" %>',
        participants: <%- participantsJSON || '[]' %>,
        expenses: <%- expensesJSON || '[]' %>,
        userId: '<%= userId %>'
    };
    window.currentUserId = <%= user.id %>;
    console.log("✅ travelData загружен:", window.travelData);
    console.log("✅ currentUserId:", window.currentUserId);
</script>

    <script src="/js/expenseFormUpdate.js"></script>

    <!-- Скрипты для работы с участниками -->
    <script>
        let inviteModalOpen = false;

        function inviteParticipants() {
            document.getElementById('inviteModal').style.display = 'block';
            inviteModalOpen = true;
            loadCurrentParticipants();
        }

        function closeInviteModal() {
            document.getElementById('inviteModal').style.display = 'none';
            inviteModalOpen = false;
            document.getElementById('searchResults').innerHTML = '';
            document.getElementById('userSearch').value = '';
        }

        async function loadCurrentParticipants() {
            try {
                const response = await fetch(`/api/trips/${window.travelData.id}/participants`);
                const data = await response.json();
                const container = document.getElementById('currentParticipants');
                
                console.log('=== ПРОВЕРКА ПРАВ ===');
                console.log('Текущий пользователь:', window.currentUserId);
                console.log('Создатель путешествия:', window.travelData.userId);
                
                if (data.success && data.participants.length > 0) {
                    let html = '<ul style="list-style: none; padding: 0; margin: 0;">';
                    data.participants.forEach(participant => {
                        const currentId = parseInt(window.currentUserId);
                        const creatorId = parseInt(window.travelData.userId);
                        const participantId = parseInt(participant.id);
                        
                        const isCreator = currentId === creatorId;
                        const isThisParticipant = currentId === participantId;
                        const canDelete = isCreator && !isThisParticipant;
                        
                        const deleteBtn = canDelete 
                            ? `<button onclick="removeParticipantFromTrip(${participantId}, '${participant.username}')" style="background:none; border:none; color:#dc3545; font-size:18px; cursor:pointer; margin-left:8px;">×</button>` 
                            : '';
                        
                        html += `<li style="padding: 8px 0; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #eee;">
                                    <span>👤 ${participant.username} <small style="color:#666">(${participant.email})</small></span>
                                    ${deleteBtn}
                                 </li>`;
                    });
                    html += '</ul>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p style="color:#666">Участников пока нет</p>';
                }
            } catch (error) {
                console.error('Ошибка загрузки участников:', error);
            }
        }

        let searchTimeout;
        document.getElementById('userSearch').addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => searchUsers(e.target.value), 500);
        });

        async function searchUsers(query) {
            if (!query || query.length < 2) {
                document.getElementById('searchResults').innerHTML = '';
                return;
            }

            try {
                const response = await fetch(`/api/users/search?query=${encodeURIComponent(query)}`);
                const data = await response.json();
                const resultsDiv = document.getElementById('searchResults');
                resultsDiv.innerHTML = '';
                
                if (data.success && data.users.length > 0) {
                    data.users.forEach(user => {
                        const userDiv = document.createElement('div');
                        userDiv.style.padding = '10px';
                        userDiv.style.borderBottom = '1px solid #eee';
                        userDiv.style.display = 'flex';
                        userDiv.style.justifyContent = 'space-between';
                        userDiv.style.alignItems = 'center';
                        
                        userDiv.innerHTML = `
                            <div>
                                <strong>${user.username}</strong><br>
                                <small>${user.email}</small>
                            </div>
                            <button class="invite" onclick="inviteUser(${user.id}, '${user.username}')">Пригласить</button>
                        `;
                        resultsDiv.appendChild(userDiv);
                    });
                } else {
                    resultsDiv.innerHTML = '<p style="color: #666; padding: 10px;">Пользователи не найдены</p>';
                }
            } catch (error) {
                console.error('Ошибка поиска:', error);
            }
        }

        async function inviteUser(userId, username) {
            try {
                const response = await fetch(`/api/trips/${window.travelData.id}/invite`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: userId })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert(`✅ Пользователь ${username} приглашен!`);
                    loadCurrentParticipants();
                    document.getElementById('searchResults').innerHTML = '';
                    document.getElementById('userSearch').value = '';
                } else {
                    alert(`❌ ${data.message || 'Ошибка приглашения'}`);
                }
            } catch (error) {
                console.error('Ошибка приглашения:', error);
                alert('❌ Ошибка приглашения');
            }
        }

        document.getElementById('inviteModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeInviteModal();
            }
        });

        async function removeParticipantFromTrip(userId, username) {
            if (!confirm(`Удалить "${username}" из путешествия?`)) return;
            
            try {
                const response = await fetch(`/api/trips/${window.travelData.id}/participants/${userId}`, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    loadCurrentParticipants();
                } else {
                    alert('❌ ' + (result.error || 'Ошибка удаления'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('❌ Ошибка соединения');
            }
        }

        // Обработчики кнопок
        document.addEventListener('DOMContentLoaded', function() {
            const inviteBtn = document.getElementById('inviteParticipantsBtn');
            if (inviteBtn) {
                inviteBtn.addEventListener('click', function() {
                    inviteParticipants();
                });
            }
            
            const chatBtn = document.getElementById('openChatBtn');
            if (chatBtn) {
                chatBtn.addEventListener('click', function() {
                    if (typeof window.openChatModal === 'function') {
                        window.openChatModal();
                    } else {
                        console.error('❌ Функция openChatModal не загружена');
                        alert('Чат ещё загружается...');
                    }
                });
            }
        });

        // CSS для аватаров
        const style = document.createElement('style');
        style.textContent = `
            .participant-avatar {
                display: inline-block;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #3e9afc;
                color: white;
                text-align: center;
                line-height: 32px;
                margin-right: -10px;
                border: 2px solid white;
            }
            .participant-avatar.more {
                background: #6c757d;
            }
        `;
        document.head.appendChild(style);

        // Удаление путешествия
        async function deleteTravel(id, name) {
            if (!confirm('Удалить "' + name + '"?\nЭто действие нельзя отменить.')) {
                return;
            }
            
            try {
                const res = await fetch('/api/travels/' + id, { method: 'DELETE' });
                const result = await res.json();
                
                if (result.success) {
                    alert('✅ Путешествие удалено');
                    window.location.href = '/';
                } else {
                    alert('❌ ' + (result.error || 'Ошибка удаления'));
                }
            } catch (e) {
                console.error('Ошибка:', e);
                alert('❌ Ошибка соединения с сервером');
            }
        }
    </script>

