<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= travel.name %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/public/icoplane.png" type="image/png">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/expensesChart.js" defer></script>
    <script src="/js/travelPage.js" defer></script>
</head>

<body>
    <div class="header">
        <a href="/" class="nav"><svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#e3e3e3">
            <path d="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z"/>
        </svg></a>
        <button id="menuBtn" class="nav menu-btn" style="background: none; border: none; cursor: pointer;"><svg xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="#000000"><path d="M240-400q-33 0-56.5-23.5T160-480q0-33 23.5-56.5T240-560q33 0 56.5 23.5T320-480q0 33-23.5 56.5T240-400Zm240 0q-33 0-56.5-23.5T400-480q0-33 23.5-56.5T480-560q33 0 56.5 23.5T560-480q0 33-23.5 56.5T480-400Zm240 0q-33 0-56.5-23.5T640-480q0-33 23.5-56.5T720-560q33 0 56.5 23.5T800-480q0 33-23.5 56.5T720-400Z"/></svg></button>
    </div>

    <div class="hero">
        <% if (travel.photo) { %>
            <img class="hero_image" src="<%= travel.photo %>" alt="<%= travel.name %>">
        <% } else { %>
            <div class="hero_image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
        <% } %>
        <div class="overlay_block">
            <h2 class="overlay_title"><%= travel.name %></h2>
            <% if (travel.date_range) { %>
                <p class="overlay_date"><%= travel.date_range %></p>
            <% } %>
            
            <% if (userId && travel.user_id && userId == travel.user_id) { %>
                <button onclick="deleteTravel(<%= travel.id %>, '<%= travel.name.replace(/'/g, "\\'") %>')" 
                        style="margin-top: 12px; padding: 8px 16px; background: #dc3545; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px;">
                    🗑️ Удалить путешествие
                </button>
            <% } %>
        </div>
    </div>

    <!-- Блок участников и кнопок -->
    <div class="participants_block" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #f8f9fa; border-radius: 12px; margin-bottom: 20px;">
        <div class="participants_left" style="display: flex; align-items: center; gap: 12px;">
            <span class="participants_title">Участники (<%= participants.length %>)</span>
            <div class="participants_avatars" id="participantsAvatars">
                <% participants.forEach(function(participant, index) { %>
                    <% if (index < 3) { %>
                        <div class="participant-avatar"><%= participant.username.charAt(0).toUpperCase() %></div>
                    <% } %>
                <% }); %>
                <% if (participants.length > 3) { %>
                    <div class="participant-avatar more">+<%= participants.length - 3 %></div>
                <% } %>
            </div>
        </div>

        <div style="display: flex; gap: 10px;">
            <button id="inviteParticipantsBtn" style="padding: 8px 16px; background: #f5de4c; box-shadow: 0 2px 2px rgba(0, 0, 0, 0.2);border: none; border-radius: 8px; cursor: pointer; font-weight: 500;">
                Share
            </button>
            <button id="openChatBtn" style="padding: 8px 16px; background: #f5de4c; color: rgb(17, 17, 17); border: none; border-radius: 8px; box-shadow: 0 2px 2px rgba(0, 0, 0, 0.2); cursor: pointer; font-weight: 500;">
                Чат
            </button>
            <button id="openDebtsBtn" style="padding: 8px 16px; background: #28a745; color: white; border: none; border-radius: 8px; box-shadow: 0 2px 2px rgba(0, 0, 0, 0.2); cursor: pointer; font-weight: 500;">
                 Долги
            </button>
        </div>
    </div>

    <div class="expenses">
        <div class="expenses_header">
            <h2 class="expenses_title">Категории трат</h2>
            <button class="filter_icon"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M440-160q-17 0-28.5-11.5T400-200v-240L168-736q-15-20-4.5-42t36.5-22h560q26 0 36.5 22t-4.5 42L560-440v240q0 17-11.5 28.5T520-160h-80Zm40-308 198-252H282l198 252Zm0 0Z"/></svg></button>
        </div>

        <div class="expenses_filters">
            <div class="filter_item"><span><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M240-200v40q0 17-11.5 28.5T200-120h-40q-17 0-28.5-11.5T120-160v-320l84-240q6-18 21.5-29t34.5-11h440q19 0 34.5 11t21.5 29l84 240v320q0 17-11.5 28.5T800-120h-40q-17 0-28.5-11.5T720-160v-40H240Zm-8-360h496l-42-120H274l-42 120Zm-32 80v200-200Zm100 160q25 0 42.5-17.5T360-380q0-25-17.5-42.5T300-440q-25 0-42.5 17.5T240-380q0 25 17.5 42.5T300-320Zm360 0q25 0 42.5-17.5T720-380q0-25-17.5-42.5T660-440q-25 0-42.5 17.5T600-380q0 25 17.5 42.5T660-320Zm-460 40h560v-200H200v200Z"/></svg></span></div>
            <div class="filter_item"><span><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M533-440q-32-45-84.5-62.5T340-520q-56 0-108.5 17.5T147-440h386ZM40-360q0-109 91-174.5T340-600q118 0 209 65.5T640-360H40Zm0 160v-80h600v80H40ZM720-40v-80h56l56-560H450l-10-80h200v-160h80v160h200L854-98q-3 25-22 41.5T788-40h-68Zm0-80h56-56ZM80-40q-17 0-28.5-11.5T40-80v-40h600v40q0 17-11.5 28.5T600-40H80Zm260-400Z"/></svg></span></div>
            <div class="filter_item"><span><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="m233-80 54-122q-14-11-27-21.5T235-246q-8 3-15.5 4.5T203-240q-33 0-56.5-23.5T123-320q0-20 8.5-36.5T155-384q-8-23-11-46.5t-3-49.5q0-26 3-49.5t11-46.5q-15-11-23.5-27.5T123-640q0-33 23.5-56.5T203-720q9 0 16.5 1.5T235-714q33-36 75.5-60t90.5-36q5-30 27.5-50t52.5-20q30 0 52.5 20.5T561-810q48 12 90.5 35.5T727-716q8-3 15-4.5t15-1.5q33 0 56.5 23.5T837-642q0 20-8 35.5T807-580q8 24 11 49t3 51q0 26-3 50.5T807-382q14 11 22 26.5t8 35.5q0 33-23.5 56.5T757-240q-8 0-15-1.5t-15-4.5q-12 12-24.5 23.5T675-200l52 120h-74l-38-88q-14 6-27 10.5t-27 7.5q-5 29-27.5 49.5T481-80q-30 0-52.5-20T401-150q-15-3-28.5-7.5T345-168l-38 88h-74Zm76-174 62-140q-14-18-22-40t-8-46q0-57 41.5-98.5T481-620q57 0 98.5 41.5T621-480q0 24-8.5 47T589-392l62 138q9-8 17.5-14.5T685-284q-5-8-6.5-17.5T677-320q0-32 22-55t54-25q6-20 9-39.5t3-40.5q0-21-3-41.5t-9-40.5q-32-2-54-25t-22-55q0-9 2.5-17.5T685-676q-29-29-64-49t-74-31q-11 17-28 26.5t-38 9.5q-21 0-38-9.5T415-756q-41 11-76 31.5T275-674q3 8 5.5 16.5T283-640q0 32-21 54.5T209-560q-6 20-9 39.5t-3 40.5q0 21 3 40.5t9 39.5q32 2 53 25t21 55q0 9-1.5 17.5T275-286q8 9 16.5 16.5T309-254Zm60 34q11 5 22.5 9t23.5 7q11-17 28-26.5t38-9.5q21 0 38 9.5t28 26.5q12-3 22.5-7t21.5-9l-58-130q-12 5-25 7.5t-27 2.5q-15 0-28.5-3t-25.5-9l-58 132Zm112-200q24 0 42-17t18-43q0-24-18-42t-42-18q-26 0-43 18t-17 42q0 26 17 43t43 17Zm0-60Z"/></svg></span></div>
        </div>

        <div class="expenses_list" id="expensesList">
            <% if (expenses.length === 0) { %>
                <div class="empty-state">
                    <p>Расходов пока нет</p>
                </div>
            <% } else { %>
                <% expenses.forEach((expense, index) => { %>
                    <div class="expense_item" data-expense-id="<%= expense.id %>">
                        <div class="expense_item_main">
                            <div class="expense_item_header">
                                <span class="expenses_item_number"><%= index + 1 %>.</span>
                                <span class="expense_item_name"><%= expense.name %></span>
                            </div>
                            <button class="expense_edit" onclick="showEditExpenseModal(<%= expense.id %>)">
                                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#000000"><path d="M216-216h51l375-375-51-51-375 375v51Zm-72 72v-153l498-498q11-11 23.84-16 12.83-5 27-5 14.16 0 27.16 5t24 16l51 51q11 11 16 24t5 26.54q0 14.45-5.02 27.54T795-642L297-144H144Zm600-549-51-51 51 51Zm-127.95 76.95L591-642l51 51-25.95-25.05Z"/></svg>
                            </button>
                        </div>
                        <div class="expense_item_cost">
                            <span class="expense_item_amount"><%= expense.amount %> <%= expense.currency %></span>
                            <div class="expense_item_date"><%= expense.date %></div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <div class="expenses_nav">
        <a class="my_expenses"><span id="totalAmount"></span></a>
        <button class="nav" id="add_expense" style="background: none; border: none; cursor: pointer; padding: 12px; border-radius: 30px; display: flex; align-items: center; justify-content: center;" ><svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#e3e3e3"><path d="M440-280h80v-160h160v-80H520v-160h-80v160H280v80h160v160Zm40 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg></button>
    </div>

    <!-- Модальное окно для приглашения участников -->
    <div id="inviteModal" class="travel_part_add_container">
        <div class="travel_part_add">
            <h2>Пригласить участников</h2>
            <div class="part_add_input">
                <input type="text" id="userSearch" placeholder="Поиск по имени или email...">
                <div class="searchResults" id="searchResults"></div>
            </div>
            <div>
                <h4>Участники:</h4>
                <div id="currentParticipants"></div>
            </div>
            <button class="close_part" onclick="closeInviteModal()">Закрыть</button>
        </div>
    </div>
    <!-- 🔹 Модальное окно долгов -->
<div id="debtsModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 600px;">
        <span class="close" onclick="closeDebtsModal()">&times;</span>
        <h2 style="margin-bottom: 20px;">💰 Долги в путешествии</h2>
        
        <!-- Общая информация -->
        <div id="debtsSummary" style="margin-bottom: 30px; padding: 15px; background: #f8f9fa; border-radius: 8px;">
            <p style="margin: 0; color: #666;">Загрузка...</p>
        </div>

        <!-- Кто кому должен -->
        <div id="debtsList" style="margin-bottom: 30px;">
            <h3 style="margin-bottom: 15px; font-size: 16px;">📋 Кто кому должен:</h3>
            <div id="settlementsContainer">
                <!-- Сюда JavaScript вставит долги -->
            </div>
        </div>

        <!-- Кнопки действий -->
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button onclick="showDebtHistory()" style="flex: 1; padding: 10px; background: #6c757d; color: white; border: none; border-radius: 6px; cursor: pointer;">
                📜 История транзакций
            </button>
            <button id="mainActionBtn" onclick="showSettleDebtForm()" style="flex: 1; padding: 10px; background: #28a745; color: white; border: none; border-radius: 6px; cursor: pointer;">
                💵 Я заплатил
            </button>
            <button onclick="exportToExcel()" style="flex: 1; padding: 10px; background: #17a2b8; color: white; border: none; border-radius: 6px; cursor: pointer;">
                📊 Excel
            </button>
        </div>
    </div>
</div>

<!-- 🔹 Модальное окно истории транзакций -->
<div id="historyModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 500px;">
        <span class="close" onclick="closeHistoryModal()">&times;</span>
        <h2 style="margin-bottom: 20px;">📜 История транзакций</h2>
        <div id="historyContainer">
            <!-- Сюда JavaScript вставит историю -->
        </div>
    </div>
</div>

<!-- 🔹 Модальное окно оплаты долга -->
<div id="settleModal" class="modal" style="display: none;" data-mode="pay">
    <div class="modal-content" style="max-width: 400px;">
        <span class="close" onclick="closeSettleModal()">&times;</span>
        <h2 style="margin-bottom: 20px;">💵 Я заплатил</h2>
        <form id="settleDebtForm" onsubmit="submitSettleDebt(event)">
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500;">Кому заплатили:</label>
                <select id="toUserId" name="toUserId" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                    <option value="">Выберите участника</option>
                </select>
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500;">Сумма (₽):</label>
                <input type="number" id="settleAmount" name="amount" step="0.01" min="0.01" required 
                       style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: 500;">Заметка (необязательно):</label>
                <input type="text" id="settleNote" name="note" placeholder="Например: перевёл на карту"
                       style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            
            <button type="submit" style="width: 100%; padding: 10px; background: #28a745; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;">
                 Записать транзакцию
            </button>
        </form>
    </div>
</div>
    <!-- Модальное окно чата -->
    <div id="chatModal" class="chat-modal" style="display: none;">
        <div class="chat-modal-content" >
            <!-- Обновленная шапка чата с поиском -->
<div class="chat-header" style="padding: 15px 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0;">Чат путешествия</h3>
        <button onclick="closeChatModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; ">&times;</button>
    </div>
    
    <!-- 🔹 Поле поиска -->
    <div style="margin-top: 10px;">
        <input type="text" id="chatSearchInput" 
               placeholder="🔍︎ Поиск по сообщениям..." 
               style="width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 20px; font-size: 14px; outline: none;
               "
               onfocus="this.style.borderColor='#3e9afc'"
               onblur="this.style.borderColor='#ddd'">
    </div>
</div>
            <div id="chatMessages" class="chat-messages" style="flex: 1; overflow-y: auto; padding: 15px 20px; ">
                <div style="text-align: center; color: #999; padding: 20px;">Загрузка сообщений...</div>
            </div>
           
        <div id="typingIndicator" style="position: absolute; bottom: 80px; left: 20px; font-size: 13px; color: #666; font-style: italic; display: none; background: rgba(255,255,255,0.9); padding: 4px 12px; border-radius: 16px;">
            <span id="typingText">Пользователь печатает</span>
            <span class="typing-dots" style="margin-left: 4px;">
                <span style="animation: blink 1.4s infinite both">.</span>
                <span style="animation: blink 1.4s infinite both 0.2s">.</span>
                <span style="animation: blink 1.4s infinite both 0.4s">.</span>
            </span>
        </div>
            <div class="chat-input-area" style="padding: 15px 20px; border-top: 1px solid #eee; display: flex; gap: 10px; align-items: flex-end; position: relative;">
    
    <!-- Кнопка фото -->
    <button onclick="togglePhotoMenu()" style="padding: 10px; border-radius: 8px; background: #f5f5f5; border: none; cursor: pointer; font-size: 20px;">
        📷
    </button>
    
    <!-- Меню выбора фото -->
    <div id="photoSourceMenu" style="display: none; position: absolute; bottom: 70px; left: 20px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); padding: 8px; z-index: 1000; min-width: 200px;">
        <button onclick="selectPhotoSource('gallery')" style="display:block;width:100%;padding:12px;border:none;background:none;text-align:left;cursor:pointer;border-radius:8px;font-size:14px;" onmouseover="this.style.background='#f5f5f5'" onmouseout="this.style.background='none'">🖼️ Из галереи</button>
        <button onclick="selectPhotoSource('files')" style="display:block;width:100%;padding:12px;border:none;background:none;text-align:left;cursor:pointer;border-radius:8px;font-size:14px;" onmouseover="this.style.background='#f5f5f5'" onmouseout="this.style.background='none'">📁 Из файлов</button>
        <button onclick="selectPhotoSource('camera')" style="display:block;width:100%;padding:12px;border:none;background:none;text-align:left;cursor:pointer;border-radius:8px;font-size:14px;" onmouseover="this.style.background='#f5f5f5'" onmouseout="this.style.background='none'"> Сфотографировать</button>
    </div>
    
    <!-- Предпросмотр фото -->
    <div id="chatImagePreview" style="display: none; max-width: 60px; max-height: 60px; border-radius: 8px; overflow: hidden;">
        <img id="chatPreviewImg" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
    
    <!-- Поле ввода -->
    <textarea id="chatTextInput" placeholder="Напишите сообщение..." rows="1" style="flex: 1; padding: 12px; border: 1px solid #ddd; border-radius: 8px; resize: none; font-size: 14px;" onkeydown="handleChatKeydown(event)"></textarea>
    
    <!-- Кнопка отправки/записи (Telegram-стиль) -->
    <button id="sendBtn" onclick="sendChatMessage()" data-mode="record" style="padding: 12px; border-radius: 50%; background: #f5f5f5; border: none; cursor: pointer; font-size: 20px; min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center;">  
    </button>
       
    <!-- Индикатор записи -->
    <div id="recordingIndicator" style="display: none; position: absolute; bottom: 70px; left: 50%; transform: translateX(-50%); background: #333; color: white; padding: 8px 16px; border-radius: 20px; font-size: 14px; font-weight: bold; z-index: 100;">
         Запись...
    </div>
</div>
        </div>
    </div>

    <!-- Модальное окно редактирования траты -->
    <div id="editExpenseModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="expenseForm.closeEditModal()">&times;</span>
            <h3>Редактировать трату</h3>
            <form id="editExpenseForm">
                <input type="hidden" id="expense_id" name="id">
                <input type="hidden" id="trip_id" name="trip_id" value="<%= travel.id %>">
                <div class="form-group">
                    <label>Название:</label>
                    <input type="text" id="expense_name" name="expense_name" required>
                </div>
                
                <!-- 🔹 НОВОЕ: Поле выбора категории -->
                <div class="form-group">
                    <label>Категория:</label>
                    <select id="expense_category" name="category" style="width:100%;padding:8px;border:1px solid #ddd;border-radius:6px;font-size:14px;">
                        <option value="">Без категории</option>
                        <option value="transport">🚗 Транспорт</option>
                        <option value="food">🍔 Еда</option>
                        <option value="hotel">🏨 Отель</option>
                        <option value="entertainment">🎭 Развлечения</option>
                        <option value="shopping">🛍️ Покупки</option>
                        <option value="other">📦 Другое</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Сумма:</label>
                    <input type="number" step="0.01" id="amount" name="amount" required>
                </div>
                <div class="form-group">
                    <label>Дата:</label>
                    <input type="date" id="date" name="date" required>
                </div>
                <div class="form-group">
                    <label>Описание:</label>
                    <textarea id="description" name="description" rows="3"></textarea>
                </div>
                <div id="participantsSection" class="participants-section">
                    <label>Участники расхода:</label>
                    <div id="participantsContainer">
                        <p>Загрузка участников...</p>
                    </div>
                </div>
                <div class="button-group">
                    <div class="group-top">
                        <button type="submit" class="btn-save">Сохранить</button>
                        <button type="button" class="btn-cancel" onclick="expenseForm.closeEditModal()">Отмена</button>
                    </div>
                    <div class="group-bottom">
                        <button type="button" class="btn-delete" onclick="expenseForm.deleteCurrentExpense()">Удалить трату</button>
                    </div>
                </div>
            </form>         
        </div>
        </div>
        <div id="chatNotifications" style="
